   } else if action != "capture" {throw HostError.invalid}
   pending=true
   let accepted=events
   let timer=Timer(timeInterval:0.08,repeats:false){[weak self] _ in
    MainActor.assumeIsolated {
     guard let self else{return}
     do{try self.capture();self.reply(["ok":true,"id":id,"events":accepted,"event_sequence":self.sequence,"point_width":self.width,"point_height":self.height,"scale":self.scale,"native_backing_width":self.nativeWidth,"native_backing_height":self.nativeHeight])}
