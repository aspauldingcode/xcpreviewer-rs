(version 1)
(deny default)
(allow syscall*)
(allow mach-bootstrap)
(allow file-read-metadata)
(allow file-map-executable (subpath "/System") (subpath "/usr/lib") (subpath "/bin") (subpath "/usr/bin"))
(allow process-exec)
(allow process-fork)
(allow sysctl-read)
(allow file-read* (subpath "/System") (subpath "/usr/lib") (subpath "/bin") (subpath "/usr/bin") (literal "/dev/null") (subpath "/private/tmp/clean-isolation-control-v3-20261019/package") (subpath "/private/tmp/clean-isolation-control-v3-20261019/work"))
(allow file-write* (literal "/dev/null") (subpath "/private/tmp/clean-isolation-control-v3-20261019/work"))
