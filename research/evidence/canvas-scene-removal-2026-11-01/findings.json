  "source_policy": {
    "workspace": "Iterate the editorScenes Set of Ref<EditorScene>; obtain each Ref.instance and call its update(forRemovedFileLocations:) with the same array. Set enumeration order is not a semantic ordering guarantee.",
    "editor_guards": "Read pinningState.file. Missing pinned PreviewFile or absent previewDescription.location exits after local cleanup without this clear/setter path.",
    "match": "Use removed-location array contains(where:) with the recovered closure, which calls generic Equatable equality for the associated Location. No path-prefix or URL normalization semantics established.",
    "matched": "When contains is true, copy current pinningState, call PinningState.clear and assign through the actual pinningState setter. False exits after local cleanup.",
    "clear": "Destroy previous optional PreviewFile and write none; sources Set.removeAll(keepingCapacity:false). This is state-value cleanup, not proof of PreviewFile instance deinit or OS/transport resource settlement.",
    "setter": "Copy old value, assign new pinningState using value witnesses, invoke pinningState.didSet, then destroy saved old state. didSet implementation and its downstream side effects are not qualified in this unit.",
    "scope": "Source call chain and state cleanup only. No row destruction, renderer/session termination, resource release timing or runtime event execution established."
  },
