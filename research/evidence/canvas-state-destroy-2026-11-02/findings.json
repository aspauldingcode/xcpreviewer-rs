  "source_policy": {
    "state_routes": "Both livePreview and staticPreview state dispatch map disabled/enabledExpectingUpdate to pending cleanup, updating to updating cleanup, succeeded to Viewable cleanup, failed to reason/update/previous cleanup.",
    "pending_updating": "Destroy capabilities/configuration only when their optional payloads are present, then clean previous Viewable only when present. Pending/Updating concrete tuple references and fields are independently bound.",
    "failed": "Pass failure-reason reference representation to swift_errorRelease, clean updating fields and optional previous Viewable. FailedReason also has canceled empty case; no actual error presence or runtime cancellation inferred.",
    "viewable": "valid status delegates to ExecutionPointUpdate<PreviewViewable existential> witness; stale status destroys its opaque existential container. Viewable capabilities/configuration cleanup follows. Contained values and callback/resource effects remain opaque.",
    "variant_matrix": "After both state cleanups, load variantMatrix groups reference and tail-call swift_bridgeObjectRelease. No per-element destruction or final deallocation observed by this source-only unit."
