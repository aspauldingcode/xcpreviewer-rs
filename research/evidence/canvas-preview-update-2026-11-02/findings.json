  "source_policy": {
    "item_assignment": "Always assign incoming DiscoveredItem to Preview.item before testing its case.",
    "non_preview_item": "Incoming item other than preview skips canvas-content synchronization after item assignment.",
    "canvas_guard": "For preview item, read optional canvasContent; absent skips creation/update. Present registry content skips instance synchronization. Unexpected content enum case diagnoses/traps.",
    "preview_content": "Copy existing CanvasPreview, assign new PreviewInstance, wrap the same preview content case as present optional and write canvasContent back. Other CanvasPreview fields are carried by the value copy; this does not establish full application/state preservation.",
    "instance_setter": "Independently pinned PreviewsUI setter loads PreviewInstance metadata function and tails to shared helper. Helper obtains that metadata and tail-calls its value witness at offset 0x28 using destination self and incoming value. No explicit extra callback in these setter/helper fragments.",
    "boundaries": "Item/canvasContent setter internals, value-witness resource release, notifications, completed render, session/state continuity and registry reconciliation remain unqualified."
