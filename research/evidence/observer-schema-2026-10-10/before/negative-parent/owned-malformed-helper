#!/Users/8amps/xcpreviewer-rs/research/venv/bin/python
import sys,json,os
roots=[int(a) for a in sys.argv[1:] if a.isdecimal()]
rows=[]
for pid in roots:
 row={'pid':pid,'parent':os.getppid(),'group':os.getppid(),'state':'L','identity':[1,2,'/owned-fixture']}
 if 'negative-parent'=='null-group':row['group']=None
 if 'negative-parent'=='negative-parent':row['parent']=-1
 if 'negative-parent'=='invalid-microseconds':row['identity'][1]=1000000
 if 'negative-parent'=='missing-group':del row['group']
 rows.append(row)
print(json.dumps(rows))
