  "source_policy": {
    "editor_order": "Get currentDocuments; compactMap using captured document key-path projection returning SourceIdentifier and adapter wrapping some. Exact key-path field encoding and currentDocuments ordering policy not independently decoded here.",
    "pin_priority": "If pinnedPreviewFile is present, obtain its sourceIdentifier and insert CollectionOfOne at range 0..<0. If absent, skip insertion. No caller-level de-duplication is established.",
    "handoff": "Obtain current previewables and call DisplayableContent.Collector.updatePreviewables with assembled source identifiers.",
    "collector": "Read existing EventStreamObservable displayableContent value. Obtain pinned/open provider sources and existing providers; form identified existing-provider lookup and call updateProviders helper for pinned=true then false, concatenate pinned then open and assign providers. Similarly obtain registry definitions, existing-registry lookup, call updateRegistries true then false, concatenate and assign registries.",
    "publication_order": "After provider/registry assignment, call updateAppPreviewVisibility, assign sortedSourceIdentifiers, then assign EventStreamObservable.wrappedValue.",
    "boundaries": "Provider/registry reconciliation helper internals, visibility implementation, observable delivery, actual row/resource teardown, native runtime behavior and completion remain unqualified."
  },
