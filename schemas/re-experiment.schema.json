{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aspauldingcode/xcpreviewer-rs/development/schemas/re-experiment.schema.json",
  "title": "RE experiment",
  "type": "object",
  "required": [
    "id",
    "adapter",
    "hypothesis",
    "depends_on",
    "resources",
    "timeout_seconds",
    "artifact_limit_mb",
    "params",
    "priority",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "adapter": {
      "enum": [
        "disassembly",
        "frida_smoke",
        "ghidra",
        "ghidra_mcp",
        "inventory",
        "lldb_smoke",
        "native_reference",
        "runtime",
        "connected_probe",
        "plist_corpus",
        "swift_metadata",
        "xcode_preview",
        "xpc_corpus",
        "xpc_negative",
        "xpc_prefix",
        "agent_discriminants",
        "raw_coder",
        "surface_corpus",
        "preview_hook_smoke",
        "surface_ipc",
        "surface_failure",
        "surface_reuse",
        "xcode_bridge_probe",
        "portable_solid",
        "surface_payload",
        "rea_native"
      ]
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1800
    },
    "artifact_limit_mb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "params": {
      "type": "object"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "equals"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "equals": {}
        }
      }
    }
  }
}
